# Load into the current shell with:
# set -a; source .env; set +a
#
# Postgres database used for persistence
EXTG_POSTGRES__DSN=postgresql+asyncpg://extg:extg@localhost:5432/extg
EXTG_POSTGRES__ECHO=false
EXTG_POSTGRES__POOL_SIZE=10
EXTG_POSTGRES__MAX_OVERFLOW=20
# Secure-by-default persistence profile:
# - do not store rendered message bodies
# - redact JSON payloads in audit/error fields
EXTG_POSTGRES__PERSIST_MESSAGE_BODIES=false
EXTG_POSTGRES__PAYLOAD_STORAGE_MODE=redacted
EXTG_SECURITY__MESSAGE_HMAC_SECRET=change-me-to-a-long-random-secret
EXTG_SECURITY__TELEGRAM_SESSION_MASTER_KEY=change-me-to-a-second-long-random-secret
EXTG_SECURITY__TELEGRAM_SESSION_KEY_VERSION=v1

# Telegram credentials for Telethon gateway
EXTG_TELEGRAM__API_ID=123456
EXTG_TELEGRAM__API_HASH=your_api_hash
EXTG_TELEGRAM__REQUEST_TIMEOUT_SECONDS=30.0
EXTG_TELEGRAM__CONNECTION_RETRIES=5
EXTG_TELEGRAM__DEFAULT_ATTACHMENT_DIR=
EXTG_TELEGRAM__ARCHIVE_IMPORT_DIR=/tmp/extg-archive-imports
EXTG_TELEGRAM__ATTACHMENT_TEMP_FILE_CLEANUP_ENABLED=true
EXTG_TELEGRAM__ATTACHMENT_TEMP_FILE_TTL_SECONDS=3600
EXTG_TELEGRAM__ATTACHMENT_TEMP_FILE_CLEANUP_INTERVAL_SECONDS=600
EXTG_TELEGRAM__ARCHIVE_IMPORT_CLEANUP_ENABLED=true
EXTG_TELEGRAM__ARCHIVE_IMPORT_TTL_SECONDS=86400
EXTG_TELEGRAM__ARCHIVE_IMPORT_CLEANUP_INTERVAL_SECONDS=600

# Optional dedicated Telethon integration service.
# - extg-telethon-service uses HOST/PORT and can omit EXTG_BOT__MIGRATION_ID
#   because it defaults EXTG_RUNTIME_ROLE=telethon_service at runtime.
# - extg-bot / extg-worker use BASE_URL to talk to that service.
EXTG_TELETHON_SERVICE__BASE_URL=
EXTG_TELETHON_SERVICE__HOST=127.0.0.1
EXTG_TELETHON_SERVICE__PORT=8092
EXTG_TELETHON_SERVICE__REQUEST_TIMEOUT_SECONDS=60.0
EXTG_TELETHON_SERVICE__INTERNAL_TOKEN=change-me-in-production

# eXpress bot configuration for pybotx adapter
# Legacy single-account mode is still supported, but multi-account mesh is preferred.
EXTG_EXPRESS__BOT_ID=your-bot-uuid
EXTG_EXPRESS__CTS_URL=https://cts.express.ms
EXTG_EXPRESS__SECRET_KEY=your-secret
# Preferred multi-account format:
# EXTG_EXPRESS__ACCOUNTS=[{"role":"primary","bot_id":"your-main-bot-uuid","bot_huid":"main-bot-huid","cts_url":"https://cts1.express.ms","secret_key":"main-secret"},{"role":"technical","bot_id":"your-helper-bot-uuid","bot_huid":"helper-bot-huid","cts_url":"https://cts2.express.ms","secret_key":"helper-secret","visible":false}]
EXTG_EXPRESS__CHAT_TYPE=GROUP_CHAT
EXTG_EXPRESS__DEFAULT_PARTICIPANT_HUIDS=00000000-0000-0000-0000-000000000000
EXTG_EXPRESS__REQUEST_TIMEOUT_SECONDS=20.0
EXTG_EXPRESS__LOCAL_IDEMPOTENCY_CACHE_ENABLED=true

# Bot-managed migration runtime
EXTG_BOT__MIGRATION_ID=tg_to_express_bot_managed
EXTG_BOT__HOST=127.0.0.1
EXTG_BOT__PORT=8080
EXTG_BOT__EVENTS_PATH=/command
EXTG_BOT__STATUS_PATH=/status
EXTG_BOT__CALLBACKS_PATH=/notification/callback
EXTG_BOT__OPERATOR_HUIDS=00000000-0000-0000-0000-000000000000
EXTG_BOT__VERIFY_REQUESTS=true
# Secure-by-default: keep wizard/session auth state out of Postgres.
EXTG_BOT__FSM_STORAGE_BACKEND=in_memory

# Background worker runtime
EXTG_WORKER__ENABLED=true
EXTG_WORKER__CONCURRENCY=2
EXTG_WORKER__POLL_INTERVAL_SECONDS=1.0
EXTG_WORKER__LEASE_DURATION_SECONDS=30.0
EXTG_WORKER__HEARTBEAT_INTERVAL_SECONDS=10.0
EXTG_WORKER__BACKPRESSURE_MAX_QUEUED_JOBS=1000
EXTG_WORKER__BACKPRESSURE_MAX_RUNNING_JOBS=100
EXTG_WORKER__RUNTIME_METRICS_ENABLED=true
EXTG_WORKER__RUNTIME_METRICS_POLL_INTERVAL_SECONDS=30.0
EXTG_WORKER__OUTBOX_PUBLISHER_ENABLED=true
EXTG_WORKER__OUTBOX_PUBLISHER_BATCH_SIZE=100
EXTG_WORKER__OUTBOX_PUBLISHER_POLL_INTERVAL_SECONDS=1.0
EXTG_WORKER__OUTBOX_PUBLISHER_LEASE_DURATION_SECONDS=30.0
EXTG_WORKER__ATTACHMENT_MAX_UPLOAD_SIZE_BYTES=104857600
EXTG_WORKER__ATTACHMENT_TRANSFER_CONCURRENCY=2
EXTG_WORKER__ATTACHMENT_SPOOL_MAX_MEMORY_BYTES=1048576

# Kafka command plane.
# When enabled:
# - outbox publisher writes durable migration commands to Kafka
# - worker consumes commands from Kafka instead of polling migration_job directly
EXTG_KAFKA__ENABLED=false
EXTG_KAFKA__BOOTSTRAP_SERVERS=localhost:9092
EXTG_KAFKA__COMMAND_TOPIC=extg.migration.command.v1
EXTG_KAFKA__RESULT_TOPIC=extg.migration.result.v1
EXTG_KAFKA__DLQ_TOPIC=extg.migration.dlq.v1
EXTG_KAFKA__CONSUMER_GROUP=extg-worker
EXTG_KAFKA__PRODUCER_CLIENT_ID=extg-producer
EXTG_KAFKA__CONSUMER_CLIENT_ID=extg-consumer
EXTG_KAFKA__CONSUMER_NAME=migration-command-consumer
EXTG_KAFKA__POLL_TIMEOUT_SECONDS=1.0
EXTG_KAFKA__PRODUCER_FLUSH_TIMEOUT_SECONDS=10.0
